// =============================================================================
// SecretBid — privacy-preserving sealed-bid auction house.
//
// Architecture (see project README / architecture docs for the full review):
//   React  ->  SecretBidAPI  ->  Midnight SDK  ->  secretbid.compact (this file)
//
// This is a SINGLE contract that owns all ledger state and all auction logic
// for every auction hosted by one deployment. There is intentionally no
// separate AuctionFactory, AuctionRegistry, or CommitmentVerifier contract —
// factory-style creation (`createAuction`) and verification (`verifyCommitment`)
// are plain functions/circuits inside this file, not standalone contracts.
//
// STATUS: complete. The data model (AuctionPhase, AuctionRecord, BidSecret,
// the ledger Maps, and the pure cryptographic helpers) is final and
// canonical, and every circuit — createAuction, commitBid, startReveal,
// revealBid, closeAuction — is production-complete: validated, authorized
// where required, and fully wired to real ledger mutations.
// =============================================================================

pragma language_version 0.23;

import CompactStandardLibrary;

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

// The lifecycle of a single auction. Transitions are one-directional:
// COMMIT -> REVEAL -> CLOSED. There is no way back to an earlier phase.
export enum AuctionPhase {
  COMMIT,
  REVEAL,
  CLOSED
}

// The public record for a single auction. One instance of this struct is
// stored per auction in the `auctions` ledger Map, keyed by `auctionId`.
//
// Field documentation:
//   auctionId    - Unique identifier for this auction, derived by
//                   `deriveAuctionId` at creation time. Doubles as the key
//                   used to look this record up in `auctions`, and as one of
//                   the inputs that scope commitments/reveals to this
//                   specific auction (see `commitments` / `revealedBids`).
//   creator      - The auction creator's per-auction pseudonymous public key
//                   (derived from their secret key + this auctionId via
//                   `deriveBidderKey`, so the same wallet creating two
//                   auctions does not produce a linkable on-chain identity).
//                   Only this key is authorized to call `startReveal` and
//                   `closeAuction`.
//   title        - Public, human-readable auction title.
//   description  - Public, human-readable auction description.
//   reservePrice - Optional public minimum winning bid. `none` means no
//                   reserve (the highest revealed bid always wins). When
//                   present, a revealed bid below this value cannot become
//                   the winning bid.
//   phase        - Current lifecycle phase (see `AuctionPhase`).
//   commitCount  - Number of bidders who have committed so far. Incremented
//                   by `commitBid`. Used for auction-health visibility
//                   (e.g. "3 bids committed") without revealing any amounts.
//   revealCount  - Number of bidders who have revealed so far. Incremented
//                   by `revealBid`. Bidders who commit but never reveal are
//                   excluded from winner selection and simply never counted
//                   here.
//   winner       - The winning bidder's per-auction pseudonymous public key,
//                   once determined. `none` until a qualifying bid has been
//                   revealed.
//   winningBid   - The winning bid amount, once determined. `none` until a
//                   qualifying bid has been revealed. Only ever set together
//                   with `winner`.
export struct AuctionRecord {
  auctionId: Bytes<32>;
  creator: Bytes<32>;
  title: Opaque<"string">;
  description: Opaque<"string">;
  reservePrice: Maybe<Uint<64>>;
  phase: AuctionPhase;
  commitCount: Uint<32>;
  revealCount: Uint<32>;
  winner: Maybe<Bytes<32>>;
  winningBid: Maybe<Uint<64>>;
}

// The private, per-auction bid a bidder holds locally: the real bid amount
// and the secret nonce used to salt its commitment hash. Never stored on the
// ledger — only ever read back out of local private state via the
// `localBidSecret` witness. See `witnesses.ts` for the TypeScript side.
export struct BidSecret {
  amount: Uint<64>;
  nonce: Bytes<32>;
}

// -----------------------------------------------------------------------------
// Ledger state
//
// Flat Maps with compound keys only — no nested Maps. Every per-bidder,
// per-auction record (commitments, revealed bids) is keyed by
// `hash(auctionId, bidderKey)` via `deriveRecordKey`, so a single flat
// `Map<Bytes<32>, V>` can represent an auctionId x bidderKey relation.
// -----------------------------------------------------------------------------

// Total number of auctions ever created on this contract. Also used, via
// `deriveAuctionId`, to guarantee every auctionId is unique.
export ledger auctionCount: Counter;

// auctionId -> AuctionRecord. The single source of truth for public auction
// metadata and lifecycle state. One entry per auction, for every auction
// this contract has ever hosted.
export ledger auctions: Map<Bytes<32>, AuctionRecord>;

// hash(auctionId, bidderKey) -> commitment hash. Populated by `commitBid`.
// Never holds a bid amount — only the opaque commitment produced by
// `createCommitment`. Membership (`commitments.member(key)`) doubles as
// "has this bidder committed to this auction".
export ledger commitments: Map<Bytes<32>, Bytes<32>>;

// hash(auctionId, bidderKey) -> revealed bid amount. Populated by
// `revealBid`, and only for bidders who chose to reveal. Membership
// doubles as "has this bidder revealed for this auction". A bidder who
// commits but never reveals has no entry here and cannot win.
export ledger revealedBids: Map<Bytes<32>, Uint<64>>;

// -----------------------------------------------------------------------------
// Witnesses
//
// Reuses the existing witness infrastructure pattern from the original
// scaffold (see witnesses.ts): each witness reads something that lives only
// in the caller's local private state and is never written to the ledger.
// -----------------------------------------------------------------------------

// Returns the caller's global secret key. Root of every per-auction
// pseudonymous identity produced by `deriveBidderKey`.
witness localSecretKey(): Bytes<32>;

// Returns the caller's locally-held bid amount and nonce for a given
// auction. Used by `commitBid` (to compute a commitment without ever
// disclosing the amount) and by `revealBid` (to prove the commitment and
// disclose the amount). Never populated from the ledger — it is written
// into local private state entirely off-chain, before `commitBid` is
// called.
witness localBidSecret(auctionId: Bytes<32>): BidSecret;

// -----------------------------------------------------------------------------
// Pure helper functions
//
// Cryptographic plumbing only. None of these read or write ledger state,
// and none of them are, or belong to, a separate contract — they exist
// purely to keep the circuits below free of inline hashing logic. Each has
// exactly one responsibility, and no responsibility is duplicated between
// them:
//   deriveAuctionId    -> auction identifier generation
//   deriveBidderKey    -> bidder pseudonymous identity (the SOLE identity
//                         derivation mechanism in this contract — every
//                         circuit below identifies its caller by calling
//                         this function, and nothing else)
//   deriveRecordKey    -> compound storage key
//   createCommitment   -> commitment hash creation
//   verifyCommitment   -> commitment verification
// -----------------------------------------------------------------------------

// Responsibility: auction identifier generation only.
//
// Derives a unique auctionId from a caller-supplied seed (in practice, the
// current `auctionCount`) and the creator's raw secret key. Uniqueness is
// guaranteed by the caller incrementing `auctionCount` once per auction.
//
// This is the one place in the contract a secret key is hashed directly
// rather than via `deriveBidderKey`: at auction-creation time no auctionId
// exists yet, so there is nothing to scope a per-auction identity to. Once
// this function returns an auctionId, every subsequent identity derivation
// for that auction — including the creator's own — goes through
// `deriveBidderKey`, never through this function.
export circuit deriveAuctionId(seed: Bytes<32>, secretKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "secretbid:auction:"), seed, secretKey]);
}

// Responsibility: bidder pseudonymous identity only.
//
// This is the SOLE identity derivation mechanism in SecretBid:
//   secretKey -> deriveBidderKey(secretKey, auctionId) -> per-auction
//   pseudonymous identity.
// Every party's on-ledger identity — auction creators, bidders, the
// `winner` field — is this function's output for some auctionId, and
// nothing else. The same secret key produces an unlinkable key in every
// different auction. There is no other identity-deriving helper anywhere
// in the contract, the witnesses, or any API/CLI/UI layer that consumes it.
export circuit deriveBidderKey(secretKey: Bytes<32>, auctionId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "secretbid:bidder:"), auctionId, secretKey]);
}

// Responsibility: commitment hash creation only.
//
// Computes the commitment hash for a bid: binds the bid amount and nonce to
// a specific auction and a specific bidder, so commitments cannot be
// replayed across auctions or bidders.
export circuit createCommitment(
  auctionId: Bytes<32>,
  bidderKey: Bytes<32>,
  amount: Uint<64>,
  nonce: Bytes<32>,
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([auctionId, bidderKey, amount as Field as Bytes<32>, nonce]);
}

// Responsibility: commitment verification only.
//
// Recomputes a commitment from a claimed (amount, nonce) reveal and checks
// it against a previously stored commitment hash. This is the core
// zero-knowledge check that makes a reveal honest. Delegates hashing to
// `createCommitment` rather than duplicating the hash construction.
export circuit verifyCommitment(
  commitment: Bytes<32>,
  auctionId: Bytes<32>,
  bidderKey: Bytes<32>,
  amount: Uint<64>,
  nonce: Bytes<32>,
): Boolean {
  return commitment == createCommitment(auctionId, bidderKey, amount, nonce);
}

// Responsibility: compound storage key only.
//
// Combines an auctionId and a bidderKey (itself always the output of
// `deriveBidderKey`) into the single compound key used to index
// `commitments` and `revealedBids` (see the ledger section above).
export circuit deriveRecordKey(auctionId: Bytes<32>, bidderKey: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([auctionId, bidderKey]);
}

// -----------------------------------------------------------------------------
// Circuits
//
// All five circuits — createAuction, commitBid, startReveal, revealBid,
// closeAuction — are production-complete: fully validated, with real
// ledger mutations.
// -----------------------------------------------------------------------------

// createAuction — PRODUCTION IMPLEMENTATION.
//   Inputs:  title        - public, human-readable. Must not be empty.
//            description  - public, human-readable. No further constraint:
//                            Compact's `Opaque<"string">` exposes no length
//                            or content introspection, so beyond exact-empty
//                            rejection (see below), string validation is not
//                            something a circuit can perform.
//            reservePrice - optional public minimum winning bid. Any value
//                            is well-formed, including `none` (no reserve)
//                            and a reserve of `0` (every non-empty commit
//                            technically qualifies) — both are legitimate
//                            auction configurations, not malformed input.
//   Output:  the newly created auction's auctionId (Compact circuits may
//            return values directly; see `SecretBidAPI.createAuction` for
//            how the API layer reads it off the transaction result).
//   Purpose: registers a brand new auction in `auctions`, owned by the
//            caller. The creator's identity is derived via
//            `deriveBidderKey(secretKey, auctionId)` — the same canonical
//            identity derivation every other circuit uses — computed once
//            `auctionId` itself is known (see `deriveAuctionId`'s
//            documentation for why auction-creation is the one place a
//            secret key is hashed directly, rather than through
//            `deriveBidderKey`, before that point).
//   Validation:
//     - title must not be empty (`Opaque<"string">`'s only checkable
//       malformed-input case, since it has no length/trim operations).
//     - the derived auctionId must not already exist in `auctions`. This
//       should be cryptographically unreachable (auctionId is a hash of a
//       strictly-incrementing counter plus a secret key), but is asserted
//       defensively rather than assumed.
//   Ledger mutations:
//     - `auctions[auctionId]` inserted with phase = COMMIT, commitCount =
//       revealCount = 0, winner = none, winningBid = none.
//     - auctionCount incremented by 1.
export circuit createAuction(
  title: Opaque<"string">,
  description: Opaque<"string">,
  reservePrice: Maybe<Uint<64>>,
): Bytes<32> {
  assert(title != default<Opaque<"string">>, "SecretBid: title must not be empty");

  const secretKey = localSecretKey();
  const auctionId = disclose(deriveAuctionId(auctionCount as Field as Bytes<32>, secretKey));
  assert(!auctions.member(auctionId), "SecretBid: auctionId collision (should never occur)");

  const creatorKey = disclose(deriveBidderKey(secretKey, auctionId));

  auctions.insert(auctionId, disclose(AuctionRecord {
    auctionId: auctionId,
    creator: creatorKey,
    title: title,
    description: description,
    reservePrice: reservePrice,
    phase: AuctionPhase.COMMIT,
    commitCount: 0,
    revealCount: 0,
    winner: none<Bytes<32>>(),
    winningBid: none<Uint<64>>(),
  }));
  auctionCount.increment(1);

  return auctionId;
}

// commitBid — PRODUCTION IMPLEMENTATION.
//   Inputs:  auctionId of the auction being bid on. The bid amount and
//            nonce are never taken as parameters — they are read from
//            local private state via `localBidSecret(auctionId)`, so the
//            bidder's actual bid never appears in a transaction argument
//            or on the ledger. Only the commitment hash produced by
//            `createCommitment` is ever stored publicly.
//   Output:  none.
//   Purpose: records a sealed (hashed) bid for the caller against a
//            specific auction. The caller's identity is derived via
//            `deriveBidderKey(secretKey, auctionId)` — the sole identity
//            model used throughout this contract.
//   Validation:
//     - the auction must exist (`auctions.member(auctionId)`).
//     - the auction must be in the COMMIT phase.
//     - the caller must not have already committed to this auction
//       (`!commitments.member(deriveRecordKey(auctionId, bidderKey))`).
//     - the witness-supplied nonce must not be the all-zero default — the
//       one malformed-witness-data condition Compact's type system doesn't
//       already rule out (a well-formed `Uint<64>` amount and `Bytes<32>`
//       nonce are otherwise unconditionally valid by construction).
//   Ledger mutations:
//     - `commitments[deriveRecordKey(auctionId, bidderKey)]` inserted with
//       `createCommitment(auctionId, bidderKey, amount, nonce)`.
//     - `auctions[auctionId].commitCount` incremented by 1.
//   Any assertion failure aborts the circuit before either ledger mutation
//   runs, so a rejected call leaves `commitments` and `auctions` unchanged.
export circuit commitBid(auctionId: Bytes<32>): [] {
  const publicAuctionId = disclose(auctionId);
  assert(auctions.member(publicAuctionId), "SecretBid: unknown auction");
  const auction = auctions.lookup(publicAuctionId);
  assert(auction.phase == AuctionPhase.COMMIT, "SecretBid: auction is not in the commit phase");

  const bidderKey = disclose(deriveBidderKey(localSecretKey(), publicAuctionId));
  const recordKey = deriveRecordKey(publicAuctionId, bidderKey);
  assert(!commitments.member(recordKey), "SecretBid: bidder has already committed to this auction");

  const bidSecret = localBidSecret(auctionId);
  assert(bidSecret.nonce != default<Bytes<32>>, "SecretBid: malformed bid secret (nonce must not be zero)");

  const commitment = disclose(createCommitment(publicAuctionId, bidderKey, bidSecret.amount, bidSecret.nonce));
  commitments.insert(recordKey, commitment);

  auctions.insert(publicAuctionId, AuctionRecord {
    auctionId: auction.auctionId,
    creator: auction.creator,
    title: auction.title,
    description: auction.description,
    reservePrice: auction.reservePrice,
    phase: auction.phase,
    commitCount: (auction.commitCount + 1) as Uint<32>,
    revealCount: auction.revealCount,
    winner: auction.winner,
    winningBid: auction.winningBid,
  });
}

// startReveal — PRODUCTION IMPLEMENTATION.
//   Inputs:  auctionId of the auction to transition.
//   Output:  none.
//   Purpose: moves an auction from the COMMIT phase into the REVEAL phase.
//            This circuit's sole responsibility is that phase transition —
//            it performs no reveal logic of any kind. Restricted to the
//            auction's creator, identified via
//            `deriveBidderKey(secretKey, auctionId)` — the sole identity
//            model used throughout this contract.
//   Validation:
//     - the auction must exist (`auctions.member(auctionId)`).
//     - the caller must be the auction's creator
//       (`deriveBidderKey(secretKey, auctionId) == auctions[auctionId].creator`).
//     - the auction must currently be in the COMMIT phase (rejects both an
//       auction already in REVEAL and one already CLOSED).
//   Ledger mutations:
//     - `auctions[auctionId].phase` set to REVEAL. Every other field of the
//       `AuctionRecord` — commitCount, revealCount, winner, winningBid — is
//       carried over unchanged. `commitments` and `revealedBids` are not
//       touched at all.
//   Any assertion failure aborts the circuit before the ledger mutation
//   runs, so a rejected call leaves `auctions` (and every other ledger Map)
//   unchanged.
export circuit startReveal(auctionId: Bytes<32>): [] {
  const publicAuctionId = disclose(auctionId);
  assert(auctions.member(publicAuctionId), "SecretBid: unknown auction");
  const current = auctions.lookup(publicAuctionId);

  const callerKey = disclose(deriveBidderKey(localSecretKey(), publicAuctionId));
  assert(callerKey == current.creator, "SecretBid: only the auction creator may start the reveal phase");
  assert(current.phase == AuctionPhase.COMMIT, "SecretBid: auction is not in the commit phase");

  auctions.insert(publicAuctionId, AuctionRecord {
    auctionId: current.auctionId,
    creator: current.creator,
    title: current.title,
    description: current.description,
    reservePrice: current.reservePrice,
    phase: AuctionPhase.REVEAL,
    commitCount: current.commitCount,
    revealCount: current.revealCount,
    winner: current.winner,
    winningBid: current.winningBid,
  });
}

// revealBid — PRODUCTION IMPLEMENTATION.
//   Inputs:  auctionId of the auction being revealed for. The bid amount
//            and nonce are never taken as parameters — they are read from
//            local private state via `localBidSecret(auctionId)`, exactly
//            as in `commitBid`.
//   Output:  none.
//   Purpose: proves, in zero knowledge, that the caller's earlier
//            commitment corresponds to a specific (amount, nonce) pair,
//            records the revealed amount publicly, and incrementally
//            maintains the running winner — since circuits cannot iterate
//            the full bidder set in one call, each reveal compares itself
//            against the current leader rather than a final pass computing
//            the winner over every bidder. This circuit does not close the
//            auction; that remains `closeAuction`'s sole responsibility.
//            The caller's identity is derived via
//            `deriveBidderKey(secretKey, auctionId)` — the sole identity
//            model used throughout this contract.
//   Validation:
//     - the auction must exist (`auctions.member(auctionId)`).
//     - the auction must be in the REVEAL phase.
//     - the caller must have an existing commitment
//       (`commitments.member(deriveRecordKey(auctionId, bidderKey))`).
//     - the caller must not have already revealed
//       (`!revealedBids.member(deriveRecordKey(auctionId, bidderKey))`).
//     - the witness-supplied nonce must not be the all-zero default (same
//       malformed-witness-data check as `commitBid`).
//     - `createCommitment(auctionId, bidderKey, amount, nonce)` must equal
//       the commitment stored at reveal time — this is the core
//       zero-knowledge proof that the reveal is honest.
//   Winner-selection rule (see `AuctionRecord.reservePrice` for the exact
//   semantics of "meets reserve"):
//     - a reveal that does not meet the reserve price is still recorded in
//       `revealedBids` and still increments `revealCount`, but never
//       updates `winner`/`winningBid`.
//     - a reveal that meets the reserve becomes the new leader if there is
//       no current winner, or if its amount is *strictly greater than* the
//       current `winningBid`. Equal bids do NOT replace the existing
//       winner — the first qualifying reveal at a given amount wins ties.
//   Ledger mutations:
//     - `revealedBids[deriveRecordKey(auctionId, bidderKey)]` inserted with
//       the disclosed amount only — the nonce is never written anywhere on
//       the ledger.
//     - `auctions[auctionId].revealCount` incremented by 1.
//     - `auctions[auctionId].winner`/`winningBid` updated only per the
//       winner-selection rule above; otherwise left unchanged.
//   Any assertion failure aborts the circuit before either ledger mutation
//   runs, so a rejected call leaves `revealedBids` and `auctions` unchanged.
export circuit revealBid(auctionId: Bytes<32>): [] {
  const publicAuctionId = disclose(auctionId);
  assert(auctions.member(publicAuctionId), "SecretBid: unknown auction");
  const current = auctions.lookup(publicAuctionId);
  assert(current.phase == AuctionPhase.REVEAL, "SecretBid: auction is not in the reveal phase");

  const bidderKey = disclose(deriveBidderKey(localSecretKey(), publicAuctionId));
  const recordKey = deriveRecordKey(publicAuctionId, bidderKey);
  assert(commitments.member(recordKey), "SecretBid: bidder never committed to this auction");
  assert(!revealedBids.member(recordKey), "SecretBid: bidder has already revealed");

  const bidSecret = localBidSecret(auctionId);
  assert(bidSecret.nonce != default<Bytes<32>>, "SecretBid: malformed bid secret (nonce must not be zero)");

  const storedCommitment = commitments.lookup(recordKey);
  const expectedCommitment = createCommitment(publicAuctionId, bidderKey, bidSecret.amount, bidSecret.nonce);
  assert(storedCommitment == expectedCommitment, "SecretBid: commitment mismatch");

  const amount = disclose(bidSecret.amount);
  revealedBids.insert(recordKey, amount);

  const newRevealCount = (current.revealCount + 1) as Uint<32>;
  const meetsReserve = current.reservePrice.is_some ? amount >= current.reservePrice.value : true;
  const becomesWinner = meetsReserve && (!current.winningBid.is_some || amount > current.winningBid.value);

  if (becomesWinner) {
    auctions.insert(publicAuctionId, AuctionRecord {
      auctionId: current.auctionId,
      creator: current.creator,
      title: current.title,
      description: current.description,
      reservePrice: current.reservePrice,
      phase: current.phase,
      commitCount: current.commitCount,
      revealCount: newRevealCount,
      winner: some<Bytes<32>>(bidderKey),
      winningBid: some<Uint<64>>(amount),
    });
  } else {
    auctions.insert(publicAuctionId, AuctionRecord {
      auctionId: current.auctionId,
      creator: current.creator,
      title: current.title,
      description: current.description,
      reservePrice: current.reservePrice,
      phase: current.phase,
      commitCount: current.commitCount,
      revealCount: newRevealCount,
      winner: current.winner,
      winningBid: current.winningBid,
    });
  }
}

// closeAuction — PRODUCTION IMPLEMENTATION.
//   Inputs:  auctionId of the auction to close.
//   Output:  none.
//   Purpose: finalizes an auction, locking it against any further reveals.
//            This circuit's sole responsibility is that phase transition —
//            it NEVER recomputes the winner. `winner`/`winningBid` were
//            already finalized incrementally by `revealBid`, one reveal at
//            a time; `closeAuction` only validates that every commitment
//            has been accounted for and flips the phase. Restricted to the
//            auction's creator, identified via
//            `deriveBidderKey(secretKey, auctionId)` — the sole identity
//            model used throughout this contract.
//   Validation:
//     - the auction must exist (`auctions.member(auctionId)`).
//     - the caller must be the auction's creator
//       (`deriveBidderKey(secretKey, auctionId) == auctions[auctionId].creator`).
//     - the auction must currently be in the REVEAL phase (rejects both an
//       auction still in COMMIT and one already CLOSED).
//     - every commitment must be accounted for: `revealCount ==
//       commitCount`. This prevents closing while a bidder who committed
//       still has an outstanding, unrevealed bid.
//   Ledger mutations:
//     - `auctions[auctionId].phase` set to CLOSED. Every other field of the
//       `AuctionRecord` — commitCount, revealCount, winner, winningBid — is
//       carried over unchanged, exactly as `revealBid` last left it.
//       `commitments` and `revealedBids` are not touched at all.
//   Any assertion failure aborts the circuit before the ledger mutation
//   runs, so a rejected call leaves `auctions` (and every other ledger Map)
//   unchanged.
export circuit closeAuction(auctionId: Bytes<32>): [] {
  const publicAuctionId = disclose(auctionId);
  assert(auctions.member(publicAuctionId), "SecretBid: unknown auction");
  const current = auctions.lookup(publicAuctionId);

  const callerKey = disclose(deriveBidderKey(localSecretKey(), publicAuctionId));
  assert(callerKey == current.creator, "SecretBid: only the auction creator may close the auction");
  assert(current.phase == AuctionPhase.REVEAL, "SecretBid: auction is not in the reveal phase");
  assert(current.revealCount == current.commitCount, "SecretBid: not every commitment has been revealed");

  auctions.insert(publicAuctionId, AuctionRecord {
    auctionId: current.auctionId,
    creator: current.creator,
    title: current.title,
    description: current.description,
    reservePrice: current.reservePrice,
    phase: AuctionPhase.CLOSED,
    commitCount: current.commitCount,
    revealCount: current.revealCount,
    winner: current.winner,
    winningBid: current.winningBid,
  });
}

// -----------------------------------------------------------------------------
// getAuction / getWinner
//
// Deliberately NOT defined as circuits here. Midnight ledger state is
// publicly queryable off-chain (see SecretBidAPI.getAuction / .getWinner in
// the API layer), so reading an AuctionRecord does not require a
// transaction or a circuit call. Introducing on-chain read circuits for
// this would only add unnecessary proving/gas cost for data that is
